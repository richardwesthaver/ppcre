;;; ~/comp/ext/cl-ppcre/cl-ppcre.sys --- CL-PPCRE System Definitions
(defsys :ppcre
 :version "2.1.2"
 :description "Perl-compatible regular expression library"
 :components ((:file "pkg")
              (:file "var")
              (:file "util")
              (:file "errors")
              (:file "charset")
              (:file "charmap")
              (:file "chartest")
              (:file "lexer")
              (:file "parser")
              (:file "regex-class")
              (:file "regex-class-util")
              (:file "convert")
              (:file "optimize")
              (:file "closures")
              (:file "repetition-closures")
              (:file "scanner")
              (:file "api"))
 :provide
 ((:tests
   :description "Perl-compatible regular expression library tests"
   :require (:ppcre :rt)
   :components ((:mod "test"
                 :components ((:file "pkg")
                              (:file "tests")
                              (:file "perl-tests")))))))

(defsys :ppcre/unicode
 :description "Perl-compatible regular expression library (Unicode)"
 :components ((:mod "unicode"
               :components 
               ((:file "packages")
                (:file "resolver"))))
 :require (:ppcre :sb-unicode)
 :provide 
 ((:tests
   :description "Perl-compatible regular expression library tests (Unicode)"
   :require (:ppcre/unicode :ppcre/test :rt)
   :components ((:mod "test"
                 :components ((:file "unicode-tests")))))))
